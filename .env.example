# Copia este archivo como ".env" y rellena tus datos.
# NUNCA subas el archivo .env a git ni lo compartas.

GARMIN_USERNAME=tu_correo@gmail.com
GARMIN_PASSWORD=tu_contraseña_de_garmin

# Opcional: cuántos días hacia atrás extraer (por defecto 30).
# Amplio a propósito: el histórico se fusiona, así que una ventana grande solo
# sirve para recuperar semanas si la extracción no corrió en varios días.
DAYS_BACK=30
